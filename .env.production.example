# Set after reviewing docs/DEPLOYMENT.md and docs/PRODUCTION_CHECKLIST.md.
# Do not commit a populated .env file. This example is NOT ready to deploy.
APP_NAME=CorpusRetrieve
DEPLOYMENT_MODE=production
STORAGE_BACKEND=s3
JOB_MODE=rq
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=REPLACE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_STRONG_RANDOM_S3_SECRET
S3_BUCKET=corpusretrieve
S3_REGION=us-east-1
MINIO_ROOT_USER=REPLACE_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_STRONG_RANDOM_S3_SECRET
REDIS_URL=redis://redis:6379/0
CREDENTIAL_ENCRYPTION_KEY=REPLACE_VALID_FERNET_KEY
API_KEYS=REPLACE_LONG_RANDOM_API_KEY
CORS_ORIGINS=
CONSOLE_ENABLED=false
DEFAULT_EMBEDDER=bge-m3
INSTALL_BGE=true
OCR_LANGS=eng
REQUIRE_BIBLIOGRAPHIC=true
DEGRADED_POLICY=fail
MAX_VLM_CALLS=100
VLM_MAX_RETRIES=3
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_JOB=2000
MAX_CORPUS_UNCOMPRESSED_BYTES=524288000
DELETE_INPUTS_AFTER_PROCESSING=true
