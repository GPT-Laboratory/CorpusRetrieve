# ---------------------------------------------------------------- identity
APP_NAME=CorpusRetrieve

# ------------------------------------------------------------ artifact store
# memory: development and tests only. s3: any S3-compatible object store.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=corpusretrieve
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=corpusretrieve
S3_REGION=us-east-1

# ------------------------------------------------------------- job dispatch
# inline: process inside the API process. rq: dispatch to separate workers.
JOB_MODE=rq
REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=604800
ARTIFACT_RETENTION_DAYS=7

# ------------------------------------------------------- upload safety limits
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_JOB=100
MAX_CORPUS_UNCOMPRESSED_BYTES=524288000

# ----------------------------------------------------------------- embedding
# hash is always available. bge-m3 requires INSTALL_BGE=true at build time.
DEFAULT_EMBEDDER=hash
INSTALL_BGE=false

# --------------------------------------------------------- figure description
# Deployment-wide Anthropic key. Leave empty to require a per-request key
# supplied through the web interface or the X-Anthropic-API-Key header.
ANTHROPIC_API_KEY=
DEFAULT_VLM_MODEL=claude-sonnet-4-6
# Required when JOB_MODE=rq. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
CREDENTIAL_TTL_SECONDS=1800

# ------------------------------------------------------------- web interface
CONSOLE_ENABLED=true
EMIT_PAGE_PREVIEWS=true
PAGE_PREVIEW_DPI=110
MAX_PAGE_PREVIEWS_PER_DOCUMENT=200
CONSOLE_MAX_PROJECTION_POINTS=5000

# ------------------------------------------------------------------- privacy
DELETE_INPUTS_AFTER_PROCESSING=true
CORS_ORIGINS=*

# --------------------------------------------------------------- object store
MINIO_ROOT_USER=corpusretrieve
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
