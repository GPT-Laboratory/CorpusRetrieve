# ---------------------------------------------------------------- identity
APP_NAME=CorpusRetrieve
# development | production; production enforces secure shared-service settings
DEPLOYMENT_MODE=development

# ------------------------------------------------------------ artifact store
# memory: development and tests only (lost on restart).
# local: one machine, files under LOCAL_DATA_DIR. s3: any S3-compatible store.
# LOCAL_DATA_DIR=corpusretrieve-data
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=corpusretrieve
S3_SECRET_KEY=replace-with-a-long-random-secret
S3_BUCKET=corpusretrieve
S3_REGION=us-east-1

# ------------------------------------------------------------- job dispatch
# inline: process inside the API process. rq: dispatch to separate workers.
JOB_MODE=rq
REDIS_URL=redis://redis:6379/0
JOB_TTL_SECONDS=604800
ARTIFACT_RETENTION_DAYS=7

# ------------------------------------------------------- upload safety limits
MAX_UPLOAD_BYTES=104857600
MAX_FILES_PER_JOB=2000
MAX_FORM_FIELD_BYTES=33554432
EMBEDDING_BATCH_SIZE=256
MAX_CORPUS_UNCOMPRESSED_BYTES=524288000

# ----------------------------------------------------------------- embedding
# hash and hash-v2 are always available. Semantic models (st:intfloat/multilingual-e5-small,
# st:intfloat/multilingual-e5-base, bge-m3) need requirements-embeddings.txt;
# see docs/EMBEDDINGS.md. bge-m3 in Docker requires INSTALL_BGE=true at build time.
DEFAULT_EMBEDDER=hash
INSTALL_BGE=false

# --------------------------------------------------------- figure description
# Deployment-wide Anthropic key. Leave empty to require a per-request key
# supplied through the web interface or the X-Anthropic-API-Key header.
ANTHROPIC_API_KEY=
DEFAULT_VLM_MODEL=claude-sonnet-4-6
# Required when JOB_MODE=rq. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
CREDENTIAL_TTL_SECONDS=1800

# ------------------------------------------------------------- web interface
CONSOLE_ENABLED=true
EMIT_PAGE_PREVIEWS=true
PAGE_PREVIEW_DPI=110
MAX_PAGE_PREVIEWS_PER_DOCUMENT=200
CONSOLE_MAX_PROJECTION_POINTS=5000

# ------------------------------------------------------------------- privacy
DELETE_INPUTS_AFTER_PROCESSING=true
# empty = same-origin only (the bundled web interface needs nothing else)
CORS_ORIGINS=
# comma-separated API keys; required for any shared deployment
API_KEYS=

# ---------------------------------------------------------- build quality
# every listed Tesseract language must be installed
OCR_LANGS=eng
# full path to tesseract(.exe) when it is not on PATH
TESSERACT_CMD=
# fail: degraded builds are published but the job fails (release_ready=false)
# warn: degraded builds complete with warnings
DEGRADED_POLICY=fail
# 0 = unlimited; otherwise a hard cap on VLM calls per job
MAX_VLM_CALLS=0
VLM_MAX_RETRIES=3
VLM_TIMEOUT_SECONDS=120
# stop figure descriptions after this many failures in a row
VLM_MAX_CONSECUTIVE_FAILURES=25
# also keep dense vectors inside vectors.jsonl (they are always in index/dense.npy)
INDEX_INLINE_VECTORS=true
PYTHONHASHSEED=0

# --------------------------------------------------------------- object store
MINIO_ROOT_USER=corpusretrieve
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret


# Require resolvable bibliographic metadata for every indexed unit (true for research builds).
REQUIRE_BIBLIOGRAPHIC=false
